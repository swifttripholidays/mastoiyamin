# Neon Postgres connection string (from Vercel > Storage > Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Common Vercel/Neon aliases are also accepted: POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, NEON_DATABASE_URL

# Vercel Blob creates BLOB_READ_WRITE_TOKEN when you connect a Blob store.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Private admin access. Use a long random secret/code in Vercel Environment Variables.
ADMIN_ACCESS_CODE=choose-a-long-private-code
ADMIN_SESSION_SECRET=generate-a-random-32-byte-secret

# Canonical public URL used by metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
